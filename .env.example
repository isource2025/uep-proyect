# =============================================================================
# Variables para Vercel (Settings → Environment Variables)
# =============================================================================

# SQL Server — conexión principal de la app
DATABASE_URL=sqlserver://181.4.71.230:1433;database=iSource;user=sa;password=TU_PASSWORD;encrypt=false;trustServerCertificate=true

# Better Auth — obligatorio en producción
# Generá un valor aleatorio largo: openssl rand -base64 32
BETTER_AUTH_SECRET=genera-un-secreto-aleatorio-largo-aqui 

# URL pública de la app en Vercel (sin barra final)
BETTER_AUTH_URL=https://tu-proyecto.vercel.app
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app

# Opcionales — solo si algún script las usa
DB_SERVER=181.4.71.230
DB_PORT=1433
DB_NAME=iSource
DB_USER=sa
DB_PASSWORD=TU_PASSWORD
