// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  output     = "../lib/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "sqlserver"
}

// ==========================================
// 1. BETTER AUTH MODELS
// ==========================================

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  dni           String
  isAdmin       Boolean?  @map("isAdmin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt @map("updatedAt")

  // Additional fields needed by better-auth or custom role logic
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("OPERATOR") // ADMIN, HOSPITAL_USER, OPERATOR
  hospitalId    Int?      // Links to their hospital (Proveedor IDPROVEEDOR)
  hospital      Proveedor? @relation(fields: [hospitalId], references: [id])

  sessions      Session[]
  accounts      Account[]

  @@map("Users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.VarChar(Max)
  refreshToken          String?   @db.VarChar(Max)
  idToken               String?   @db.VarChar(Max)
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ==========================================
// 2. SYSTEM / CONFIG / PORTAL MODELS
// ==========================================

model PeriodoIVA {
  anio        Int       @map("Anio") @db.SmallInt
  mes         Int       @map("Mes") @db.SmallInt
  iva         String    @map("IVA") @db.Char(1)
  fechaCierre DateTime? @map("Fecha_Cierre")
  fechaAlta   DateTime? @map("Fecha_Alta")
  fechaMod    DateTime? @map("Fecha_Mod")

  liquidations Liquidation[]

  @@id([anio, mes, iva])
  @@map("Periodos_IVA")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 3. ERP / IMPORT SIMULATED TABLES
// ==========================================

model Cliente {
  id     Int     @id @map("IdCliente")
  nombre String  @map("Razon_Social")
  cuit   Decimal @map("Nro_CUIT")
  cbtes  Cbte[]

  @@map("Clientes")
}

model Proveedor {
  id     Int      @id @map("IDPROVEEDOR")
  nombre String?  @map("DESCRIPCION")
  cuit   Decimal? @map("NRO_CUIT")
  code   String?  @map("NOMBRE_FANTASIA")

  // Relationships previously on Hospital
  users     User[]
  agents    Agent[]
  purchases Compra[]

  @@map("PROVEEDORES")
}

model Cbte {
  id             Int           @id @map("IdTransaccion")
  type           String        @map("TipoCbte")
  puntoVenta     String?       @map("Letra_Cbte")
  numero         Int?          @map("NroCbte")
  fecha          DateTime      @map("Fecha")
  importe        Decimal       @map("ImporteTotal") @db.Decimal(15, 2)
  clienteId      Int           @map("IdCliente")
  cliente        Cliente       @relation(fields: [clienteId], references: [id])
  hospitalCode   String?       @map("domicilio")
  
  appliedAsRc    CbteAplica[]  @relation("rcRelation")
  appliedAsFc    CbteAplica[]  @relation("fcRelation")
  liquidations   Liquidation[]

  @@map("Cbtes")
}

model CbteAplica {
  id             Int      @id @map("IdAplicabilidad")
  rcId           Int      @map("IdTrans_Origen")
  rc             Cbte     @relation("rcRelation", fields: [rcId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  fcId           Int      @map("IdTrans_Destino")
  fc             Cbte     @relation("fcRelation", fields: [fcId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  importe        Decimal  @map("Importe") @db.Decimal(15, 2)

  @@map("Cbtes_Aplica")
}

model Compra {
  id         Int        @id @map("idtransaccion")
  numero     Decimal    @map("NroCbte")
  fecha      DateTime   @map("Fecha")
  importe    Decimal    @map("ImporteTotal") @db.Decimal(15, 2)
  hospitalId Int?       @map("IdProveedor")
  hospital   Proveedor? @relation(fields: [hospitalId], references: [id])
  fcVentaId  Int?       @map("IdTransaccionFacturaVta")

  @@map("Compras")
}

// ==========================================
// 4. LIQUIDATION & DISTRIBUTION MODELS
// ==========================================

model Agent {
  id              String         @id @default(cuid())
  dni             String         @unique
  cuil            String         @unique
  nombre          String
  cargo           String
  establecimiento String
  hospitalId      Int
  hospital        Proveedor      @relation(fields: [hospitalId], references: [id])
  distributions   Distribution[]
}

model Liquidation {
  id             String              @id @default(cuid())
  periodAnio     Int                 @db.SmallInt
  periodMes      Int                 @db.SmallInt
  periodIva      String              @default("V") @db.Char(1)
  period         PeriodoIVA          @relation(fields: [periodAnio, periodMes, periodIva], references: [anio, mes, iva])
  rcId           Int
  rc             Cbte                @relation(fields: [rcId], references: [id])
  
  totalFacturado Decimal             @db.Decimal(15, 2)
  netoInicial    Decimal             @db.Decimal(15, 2)
  
  // Operator adjustments (Module 3)
  creditos       Decimal             @default(0) @db.Decimal(15, 2)
  debitos        Decimal             @default(0) @db.Decimal(15, 2)
  ajustes        Decimal             @default(0) @db.Decimal(15, 2)
  recuperos      Decimal             @default(0) @db.Decimal(15, 2)
  pendientes     Decimal             @default(0) @db.Decimal(15, 2)
  
  status         String              @default("PENDIENTE") // PENDIENTE, EN_PROCESO, CONSOLIDADA, CERRADA
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  details        LiquidationDetail[]
  distributions  Distribution[]
  attachments    Attachment[]
}

model LiquidationDetail {
  id            String      @id @default(cuid())
  liquidationId String
  liquidation   Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  fcVentaId     Int
  amount        Decimal     @db.Decimal(15, 2)
}

model Distribution {
  id               String      @id @default(cuid())
  liquidationId    String
  liquidation      Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  agentId          String
  agent            Agent       @relation(fields: [agentId], references: [id])
  
  honorarios       Decimal     @default(0) @db.Decimal(15, 2)
  sobreasignaciones Decimal    @default(0) @db.Decimal(15, 2)
  gastos           Decimal     @default(0) @db.Decimal(15, 2)
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Attachment {
  id            String      @id @default(cuid())
  liquidationId String
  liquidation   Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  createdAt     DateTime    @default(now())
}
