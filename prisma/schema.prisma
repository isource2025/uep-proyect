// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  output     = "../lib/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "sqlserver"
}

// ==========================================
// 1. BETTER AUTH MODELS
// ==========================================

model User {
  id            Int       @id @map("Valor")
  email         String?   @unique @map("email")
  password      String?   @map("Password")
  name          String    @map("ApellidoNombre")
  role          String?   @map("Rol")
  operador      String?   @map("Operador")
  matricula     Int?      @map("Matricula")
  cuit          String?   @map("CUIT")
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt
  hospitalId    Int?      @map("hospitalId")
  hospital      Proveedor? @relation(fields: [hospitalId], references: [id], map: "User_hospitalId_fkey")

  sessions      Session[]
  accounts      Account[]

  @@map("imPersonal")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.VarChar(Max)
  refreshToken          String?   @db.VarChar(Max)
  idToken               String?   @db.VarChar(Max)
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ==========================================
// 2. SYSTEM / CONFIG / PORTAL MODELS
// ==========================================

model PeriodoIVA {
  anio        Int       @map("Anio") @db.SmallInt
  mes         Int       @map("Mes") @db.SmallInt
  iva         String    @map("IVA") @db.Char(1)
  fechaCierre DateTime? @map("Fecha_Cierre")
  fechaAlta   DateTime? @map("Fecha_Alta")
  fechaMod    DateTime? @map("Fecha_Mod")

  liquidations Liquidation[]

  @@id([anio, mes, iva])
  @@map("Periodos_IVA")
}



// ==========================================
// 3. ERP / IMPORT SIMULATED TABLES
// ==========================================

model Cliente {
  id                 Int                 @id @map("IdCliente")
  nombre             String              @map("Razon_Social")
  cuit               Decimal             @map("Nro_CUIT")
  cbtes              Cbte[]
  purchases          Compra[]
  liquidationDetails LiquidationDetail[]

  @@map("Clientes")
}

model Proveedor {
  id         Int      @id @map("IDPROVEEDOR")
  nombre     String?  @map("DESCRIPCION")
  cuit       Decimal? @map("NRO_CUIT")
  code       String?  @map("NOMBRE_FANTASIA")
  tipoProvId Int?     @map("IDTIPO_PROV") @db.SmallInt

  // Relationships previously on Hospital
  users              User[]
  agents             Agent[]
  purchases          Compra[]
  liquidationDetails LiquidationDetail[]

  @@map("PROVEEDORES")
}

model Cbte {
  id             Int           @id @map("IdTransaccion")
  type           String        @map("TipoCbte")
  puntoVenta     String?       @map("Letra_Cbte")
  numero         Int?          @map("NroCbte")
  fecha          DateTime      @map("Fecha")
  importe        Decimal       @map("ImporteTotal") @db.Decimal(15, 2)
  clienteId      Int           @map("IdCliente")
  cliente        Cliente       @relation(fields: [clienteId], references: [id])
  hospitalCode   String?       @map("domicilio")
  
  appliedAsRc    CbteAplica[]  @relation("rcRelation")
  appliedAsFc    CbteAplica[]  @relation("fcRelation")
  liquidations   Liquidation[]

  @@map("Cbtes")
}

model CbteAplica {
  id             Int      @id @map("IdAplicabilidad")
  rcId           Int      @map("IdTrans_Origen")
  rc             Cbte     @relation("rcRelation", fields: [rcId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  fcId           Int      @map("IdTrans_Destino")
  fc             Cbte     @relation("fcRelation", fields: [fcId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  importe        Decimal  @map("Importe") @db.Decimal(15, 2)

  @@map("Cbtes_Aplica")
}

model Compra {
  id                 Int                 @id @map("idtransaccion")
  numero             Decimal             @map("NroCbte")
  fecha              DateTime            @map("Fecha")
  importe            Decimal             @map("ImporteTotal") @db.Decimal(15, 2)
  hospitalId         Int?                @map("IdProveedor")
  hospital           Proveedor?          @relation(fields: [hospitalId], references: [id], map: "Compras_IdProveedor_fkey")
  clienteId          Int?                @map("IdCliente")
  cliente            Cliente?            @relation(fields: [clienteId], references: [id], map: "Compras_IdCliente_fkey")
  fcVentaId          Int?                @map("IdTransaccionFacturaVta")
  liquidationDetails LiquidationDetail[]

  @@map("Compras")
}

// ==========================================
// 4. LIQUIDATION & DISTRIBUTION MODELS
// ==========================================

model Agent {
  id              Int            @id @default(autoincrement()) @map("id")
  cuil            String?        @map("cuil")
  nombre          String         @map("nombre")
  cargo           String?        @map("cargo")
  establecimiento String?        @map("establecimiento")
  hospitalId      Int?           @map("hospitalId")
  hospital        Proveedor?     @relation(fields: [hospitalId], references: [id], map: "Agent_hospitalId_fkey")
  distributions   Distribution[]

  @@map("Agent")
}

model Liquidation {
  id             Int                 @id @default(autoincrement())
  periodAnio     Int                 @db.SmallInt
  periodMes      Int                 @db.SmallInt
  periodIva      String              @default("V") @db.Char(1)
  period         PeriodoIVA          @relation(fields: [periodAnio, periodMes, periodIva], references: [anio, mes, iva])
  rcId           Int
  rc             Cbte                @relation(fields: [rcId], references: [id])
  
  mesCarga       String?             // e.g. "oct 25"
  debitsFileUrl  String?             // Local path to scanned PDF of debits sent by Obra Social
  debitsFileName String?             // Original filename of debits PDF
  
  status         String              @default("PENDIENTE") // PENDIENTE, EN_PROCESO, NOTIFICADO, CERRADA
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  details        LiquidationDetail[]
  distributions  Distribution[]
  attachments    Attachment[]
}

model LiquidationDetail {
  id              String      @id @default(cuid())
  liquidationId   Int
  liquidation     Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  
  compraId        Int?
  compra          Compra?     @relation(fields: [compraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  hospitalId      Int?
  hospital        Proveedor?  @relation(fields: [hospitalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  clienteId       Int?
  cliente         Cliente?    @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  periodo         String?     // e.g. "oct-25"
  cuit            String?
  prestadorNombre String?
  localidad       String?
  fcHospital      String?     // Invoice number of hospital, e.g. FC-C-0008-00004795
  
  totalFacturado  Decimal     @default(0) @db.Decimal(15, 2)
  creditos        Decimal     @default(0) @db.Decimal(15, 2)
  debitos         Decimal     @default(0) @db.Decimal(15, 2)
  ajustesOs       Decimal     @default(0) @db.Decimal(15, 2)
  pendientesCobro Decimal     @default(0) @db.Decimal(15, 2)
  brutoAPagar     Decimal     @default(0) @db.Decimal(15, 2)
  ga              Decimal     @default(0) @db.Decimal(15, 2)
  ajusteRecupero  Decimal     @default(0) @db.Decimal(15, 2)
  netoAPagar      Decimal     @default(0) @db.Decimal(15, 2)
}

model Distribution {
  id               String      @id @default(cuid())
  liquidationId    Int
  liquidation      Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  agentId          Int
  agent            Agent       @relation(fields: [agentId], references: [id])
  
  honorarios       Decimal     @default(0) @db.Decimal(15, 2)
  sobreasignaciones Decimal    @default(0) @db.Decimal(15, 2)
  gastos           Decimal     @default(0) @db.Decimal(15, 2)
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Attachment {
  id            String      @id @default(cuid())
  liquidationId Int
  liquidation   Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  createdAt     DateTime    @default(now())
}

model ImRol {
  id          Int      @id @map("IdRol")
  nombre      String   @map("Nombre")
  descripcion String?  @map("Descripcion")
  nivel       Int      @map("Nivel") @db.TinyInt
  activo      Boolean  @map("Activo")
  fechaCreacion DateTime @map("FechaCreacion")

  @@map("imRoles")
}

model CParametro {
  id          String   @id @map("IdParametro") @db.Char(20)
  descripcion String   @map("Descripcion") @db.Char(30)
  idEmpresa   Int      @map("IdEmpresa") @db.SmallInt
  idSucursal  Int      @map("IdSucursal") @db.SmallInt
  idCentroCosto Int    @map("IdCentro_Costo")
  idCuenta    Decimal  @map("IdCuenta") @db.Decimal(15, 2)
  ejercicio   Int      @map("Ejercicio") @db.SmallInt
  observaciones String? @map("Observaciones") @db.VarChar(4000)

  @@map("CParametros")
}
